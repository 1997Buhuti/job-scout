# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Amplify Gen 2 (local sandbox outputs / artifacts — not secrets, but env-specific)
amplify_outputs.json
amplify_outputs.json.bak
.amplify/
.stitch-ref/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
