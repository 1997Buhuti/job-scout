# Public Cognito values (optional when amplify_outputs.json is present —
# generated by `npx ampx sandbox --outputs-out-dir .`). Env vars take
# precedence over the outputs file.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Backend API Gateway HTTP API base URL (no trailing slash).
# Current stack routes live at the API root (no /dev stage prefix), e.g.
# https://xxxx.execute-api.us-east-1.amazonaws.com
# Used by the profile service and the CV upload flow.
NEXT_PUBLIC_API_URL=https://xxxx.execute-api.us-east-1.amazonaws.com
