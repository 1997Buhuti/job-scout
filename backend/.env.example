# Local / offline stage
STAGE=dev
AWS_REGION=us-east-1

# Serverless Framework Dashboard — Access Key for org "manakal"
# Create at: https://app.serverless.com → org manakal → Access Keys
# Leave blank until you paste your key into .env (never commit the real key)

# SES sandbox: when true, new profiles get an SES recipient verification email.
# Set to false once SES production access is granted.
SES_SANDBOX_MODE=true

